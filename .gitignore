# Maintenance APP — código y herramientas del proyecto

# Credenciales y configuración privada
.env
.env.*
!.env.example
/auth.json
*.pem
*.key
*.p12
*.pfx

# Dependencias
/vendor/
/node_modules/

# Datos reales: se conservan localmente, fuera del repositorio
/database/imports/
/data/*
!/data/.gitignore
!/data/*.example
!/data/*.md
!/data/*.cmd
!/data/*.ps1
!/data/scripts/

# Ejecuciones y paquetes de actualización locales
/.maintenance-updates/
/Update/
/update/
/Actualizar/

# Runtime Laravel: conservar únicamente los archivos .gitignore de estructura
/storage/**
!/storage/**/
!/storage/**/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/public/hot
/public/storage

# public/build se versiona mientras la instalación no compile Vite.
# Los scripts .cmd, .bat y .ps1 forman parte del código y se versionan.

# Bases de datos y respaldos
*.sqlite
*.sqlite3
*.db
*.sql
*.sql.gz
*.dump
*.bak
*.backup
/backups/
/backup/

# Datos persistentes locales de Docker
/docker/data/
/docker/mysql-data/
/docker/mariadb-data/
/docker/volumes/

# Temporales, registros y caché de pruebas
*.log
*.tmp
*.temp
*.cache
.phpactor.json
.phpunit.result.cache
/.phpunit.cache/

# Editores
/.fleet/
/.idea/
/.nova/
/.vscode/
/.zed/

# Sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Documentación local y paquetes comprimidos
/newDocs/
*.zip
*.rar
*.7z
*.tar
*.tar.gz
Homestead.json
Homestead.yaml
